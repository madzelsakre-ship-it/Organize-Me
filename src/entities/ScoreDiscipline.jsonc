{
  "name": "ScoreDiscipline",
  "type": "object",
  "properties": {
    "score": {
      "type": "number",
      "default": 100
    },
    "sessions_reussies": {
      "type": "number",
      "default": 0
    },
    "sessions_abandonnees": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "score"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}
