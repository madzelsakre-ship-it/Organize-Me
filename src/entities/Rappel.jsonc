{
  "name": "Rappel",
  "type": "object",
  "properties": {
    "titre": {
      "type": "string"
    },
    "heure": {
      "type": "string"
    },
    "important": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "titre",
    "heure"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}
